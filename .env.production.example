# Production Environment Variables

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBA....\n-----END PRIVATE KEY-----\n"

# Gmail SMTP (requires 2FA and App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Deployment URLs
FRONTEND_URL=https://your-project.vercel.app
BACKEND_URL=https://your-project.up.railway.app
